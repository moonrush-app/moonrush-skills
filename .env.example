# Copy to ~/.config/moonrush/.env, or export these.
# Environment variables win over the file.

# The short-lived access token. Works alone for about an hour.
MOONRUSH_TOKEN=

# THE LONG-LIVED CREDENTIAL. With it the CLI renews itself and keeps working
# for as long as the Privy session lives. Treat this file as a secret.
MOONRUSH_REFRESH_TOKEN=

# Public values, from the request headers of the Privy session call.
MOONRUSH_PRIVY_APP_ID=
MOONRUSH_PRIVY_CLIENT_ID=

# Optional. Defaults shown.
# MOONRUSH_API_BASE=https://social.moonrush.space
# MOONRUSH_ADMIN_BASE=https://moonrush-admin.contact-9ba.workers.dev
# MOONRUSH_PRIVY_ORIGIN=https://trade.moonrush.space
